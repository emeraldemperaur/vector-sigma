{
  "name": "@emeraldemperaur/vector-sigma",
  "version": "1.4.18",
  "description": "Dynamic Form Orchestrator: NPM Package",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldemperaur/vector-sigma"
  },
  "license": "MIT",
  "author": "ME",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.esm.js",
  "unpkg": "lib/index.umd.js",
  "browser": "lib/index.esm.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.esm.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "release-package": "npm run build && npx changeset publish",
    "test": "jest",
    "test:fast": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:leaks": "jest --detectOpenHandles",
    "test:changed": "jest --onlyChanged",
    "test:bail": "jest --bail",
    "test:ci": "jest --maxWorkers=50% --ci"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@react-icons/all-files": "^4.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-datepicker": "^6.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "rollup": "^4.58.1",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sass-embedded": "^1.97.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "card-validator": "^10.0.4",
    "country-flag-icons": "^1.6.12",
    "date-fns": "^4.1.0",
    "formik": "^2.4.9",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^9.13.1",
    "react-imask": "^7.6.1",
    "react-phone-number-input": "^3.4.14",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}