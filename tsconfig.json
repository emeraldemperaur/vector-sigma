{
    "compilerOptions": {
        "module": "esnext",
        "lib": [ "ES2022", "DOM", "DOM.Iterable" ], 
        "sourceMap": true,
        "jsx": "react",
        "rootDir": "src",
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        
        "paths": {
            "common/*": ["./src/common/*"],
            "components/*": ["./src/components/*"],
            "layouts/*": ["./src/layouts/*"],
            "styles/*": ["./src/styles/*"],
            "utils/*": ["./src/utils/*"]
        },
        
        "declaration": true,
        "declarationDir": "lib/types",
        "target": "es6",
        "moduleResolution": "bundler"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "lib", "build", "dist", "scripts", "acceptance-tests", "webpack"],
    "types": ["typePatches", "node", "jest"]
}